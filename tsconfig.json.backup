/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "eseller-shared": ["./dist/eseller-shared"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/user-web/tsconfig.app.json"
    },
    {
      "path": "./projects/user-web/tsconfig.spec.json"
    },
    {
      "path": "./projects/eseller-customer/tsconfig.app.json"
    },
    {
      "path": "./projects/eseller-customer/tsconfig.spec.json"
    },
    {
      "path": "./projects/eseller-seller/tsconfig.app.json"
    },
    {
      "path": "./projects/eseller-seller/tsconfig.spec.json"
    },
    {
      "path": "./projects/eseller-admin/tsconfig.app.json"
    },
    {
      "path": "./projects/eseller-admin/tsconfig.spec.json"
    },
    {
      "path": "./projects/eseller-affiliate/tsconfig.app.json"
    },
    {
      "path": "./projects/eseller-affiliate/tsconfig.spec.json"
    },
    {
      "path": "./projects/eseller-shared/tsconfig.lib.json"
    },
    {
      "path": "./projects/eseller-shared/tsconfig.spec.json"
    }
  ]
}
